rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------------
    // STRICT SECURITY FOR NOTES: Only the owner can read/write
    // --------------------------------------------------------
    match /notes/{noteId} {
      // User must be logged in, and their UID must match the note's userId
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // --------------------------------------------------------
    // Development rules for other collections
    // --------------------------------------------------------
    match /users/{userId} {
      allow read, write: if request.time < timestamp.date(2026, 7, 30);
    }
    match /matches/{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 7, 30);
    }
    match /rooms/{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 7, 30);
    }
  }
}